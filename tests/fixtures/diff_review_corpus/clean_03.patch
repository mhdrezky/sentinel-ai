 import pytest

 from src.orders.totals import order_total
+
+
+class Item:
+    def __init__(self, quantity, unit_price):
+        self.quantity = quantity
+        self.unit_price = unit_price
+
+
+def test_order_total_applies_discount():
+    assert order_total([Item(2, 10.0)], discount=0.1) == 18.0
+
+
+def test_order_total_rejects_bad_discount():
+    with pytest.raises(ValueError):
+        order_total([Item(1, 1.0)], discount=2)
